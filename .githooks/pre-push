#!/usr/bin/env bash
# Run the default local CI jobs before a push.
set -uo pipefail

if [[ "${CI_LOCAL_SKIP:-0}" == "1" ]]; then
  echo "pre-push: CI_LOCAL_SKIP=1, skipping local CI."
  exit 0
fi

needs_push=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ -z "${local_ref:-}" || -z "${local_sha:-}" ]]; then
    continue
  fi
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  needs_push=1
done

if ((needs_push == 0)); then
  echo "pre-push: no refs to push, skipping local CI."
  exit 0
fi

if ! root="$(git rev-parse --show-toplevel 2>/dev/null)" || [[ -z "$root" ]]; then
  echo "pre-push: not inside a git repository." >&2
  exit 1
fi

exec "$root/.githooks/ci-local.sh"
